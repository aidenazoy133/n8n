{
  "name": "USN — Workflow 6 — Event RSVP Confirmation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "event-rsvp",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "wf6-webhook",
      "name": "Webhook — Event RSVP",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "event-rsvp"
    },
    {
      "parameters": {
        "fromEmail": "membership@unitedscholarsnetwork.org",
        "toEmail": "={{ $json.member_email }}",
        "subject": "You're confirmed for {{ $json.event_title }}",
        "emailType": "text",
        "text": "Hi {{ $json.member_name }},\n\nYou are confirmed for {{ $json.event_title }}.\n\nDate: {{ $json.event_date }}\nTime: {{ $json.event_time }}\nLocation: {{ $json.event_location }}\n\nYou will receive a prep email 2 days before the event with details on who to connect with.\n\nUnited Scholars Network",
        "options": {
          "senderName": "United Scholars Network",
          "replyTo": "membership@unitedscholarsnetwork.org"
        }
      },
      "id": "wf6-email",
      "name": "Send Email — RSVP Confirmation",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [500, 300],
      "credentials": {
        "smtp": {
          "id": "SMTP_CREDENTIAL_ID",
          "name": "USN Gmail SMTP"
        }
      }
    }
  ],
  "connections": {
    "Webhook — Event RSVP": {
      "main": [
        [
          {
            "node": "Send Email — RSVP Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
