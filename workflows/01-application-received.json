{
  "name": "USN — Workflow 1 — Application Received Confirmation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "application-received",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "wf1-webhook",
      "name": "Webhook — Application Received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "application-received"
    },
    {
      "parameters": {
        "operation": "create",
        "application": "appXXXXXXXXXXXXXX",
        "table": "Applications",
        "options": {},
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldName": "Name",
              "fieldValue": "={{ $json.applicant_name }}"
            },
            {
              "fieldName": "Email",
              "fieldValue": "={{ $json.applicant_email }}"
            },
            {
              "fieldName": "School",
              "fieldValue": "={{ $json.school }}"
            },
            {
              "fieldName": "GPA Range",
              "fieldValue": "={{ $json.gpa_range }}"
            },
            {
              "fieldName": "Top Activity",
              "fieldValue": "={{ $json.top_activity }}"
            },
            {
              "fieldName": "Five Year Goal",
              "fieldValue": "={{ $json.five_year_goal }}"
            },
            {
              "fieldName": "Referral Source",
              "fieldValue": "={{ $json.referral_source }}"
            },
            {
              "fieldName": "Status",
              "fieldValue": "Pending"
            },
            {
              "fieldName": "Record ID",
              "fieldValue": "={{ $json.airtable_record_id }}"
            },
            {
              "fieldName": "Submitted At",
              "fieldValue": "={{ $json.submitted_at }}"
            }
          ]
        }
      },
      "id": "wf1-airtable",
      "name": "Airtable — Create Application Record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [500, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable API Token"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "membership@unitedscholarsnetwork.org",
        "toEmail": "={{ $('Webhook — Application Received').item.json.applicant_email }}",
        "subject": "We Received Your Application",
        "emailType": "text",
        "text": "Hi {{ $('Webhook — Application Received').item.json.applicant_name }},\n\nThank you for applying to United Scholars Network. We have received your application and it is now under review.\n\nOur review process typically takes 5–7 business days. You will receive an email from us with a decision once your application has been reviewed.\n\nIf you have any questions in the meantime, reply to this email.\n\nUnited Scholars Network\nmembership@unitedscholarsnetwork.org",
        "options": {
          "senderName": "United Scholars Network",
          "replyTo": "membership@unitedscholarsnetwork.org"
        }
      },
      "id": "wf1-email",
      "name": "Send Email — Application Confirmation",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [750, 300],
      "credentials": {
        "smtp": {
          "id": "SMTP_CREDENTIAL_ID",
          "name": "USN Gmail SMTP"
        }
      }
    }
  ],
  "connections": {
    "Webhook — Application Received": {
      "main": [
        [
          {
            "node": "Airtable — Create Application Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Airtable — Create Application Record": {
      "main": [
        [
          {
            "node": "Send Email — Application Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "USN",
      "id": "usn-tag"
    }
  ]
}
